[Unit]
Description=File Upload web service
After=network.target

[Service]
Type=simple
User=fileupload
Group=fileupload
WorkingDirectory=/opt/file-upload
EnvironmentFile=/opt/file-upload/.env
ExecStart=/usr/bin/dotnet /opt/file-upload/FileUpload.dll --urls http://127.0.0.1:5088
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/file-upload/Upload

[Install]
WantedBy=multi-user.target
